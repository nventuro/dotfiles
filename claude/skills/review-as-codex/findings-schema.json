        "required": ["file", "line", "end_line", "category", "rule", "flagged_by", "body", "suggestion"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "end_line": { "type": ["integer", "null"] },
          "category": {
            "type": "string",
            "enum": ["Security", "Correctness", "ApiDesign", "Architecture", "Clarity", "Naming", "Style"]
          },
          "rule": { "type": ["string", "null"] },
          "flagged_by": { "type": "array", "items": { "type": "string" } },
          "body": { "type": "string" },
          "suggestion": {
            "anyOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["before", "after"],
                "properties": {
                  "before": { "type": "string" },
                  "after": { "type": "string" }
