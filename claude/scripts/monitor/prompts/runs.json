    "Bash(gh api -f*)",
    "Bash(gh api * -f*)",
    "Bash(gh api -F*)",
    "Bash(gh api * -F*)",
    "Bash(gh api *--method*)",
    "Bash(gh api *--field*)",
    "Bash(gh api *--raw-field*)",
    "Bash(gh api *--input*)",
    "Bash(gh alias:*)",
    "Bash(gh auth:*)",
    "Bash(gh cache:*)",
    "Bash(gh extension:*)",
    "Bash(gh gist:*)",
    "Bash(gh label:*)",
    "Bash(gh release:*)",
    "Bash(gh repo:*)",
    "Bash(gh secret:*)",
    "Bash(gh variable:*)"
  ],
  "kinds": {
    "review-request": {
      "permissionMode": "dontAsk",
      "allowedTools": [
        "Read",
        "Grep",
        "Glob",
        "Bash(gh pr view {{number}}:*)",
        "Bash(gh pr diff {{number}}:*)",
        "Bash(gh api repos/{{repo}}/pulls/{{number}}/comments)",
        "Bash(gh api repos/{{repo}}/pulls/{{number}}/comments --paginate)",
        "Bash(jq:*)"
      ],
      "disallowedTools": [
        "Edit",
        "Write",
        "NotebookEdit",
        "WebFetch",
        "WebSearch"
      ]
    },
    "ci-failure": {
      "permissionMode": "auto",
      "allowedTools": ["Read", "Grep", "Glob"]
    },
    "review-feedback": {
      "permissionMode": "dontAsk",
      "allowedTools": [
        "Read",
        "Grep",
        "Glob",
        "Bash(gh pr view {{number}}:*)",
        "Bash(gh pr diff {{number}}:*)",
        "Bash(gh api repos/{{repo}}/pulls/{{number}}/comments)",
        "Bash(gh api repos/{{repo}}/pulls/{{number}}/comments --paginate)",
        "Bash(jq:*)"
      ],
      "disallowedTools": [
        "Edit",
        "Write",
        "NotebookEdit",
        "WebFetch",
        "WebSearch"
      ]
    },
    "merge-conflict": {
      "permissionMode": "dontAsk",
      "allowedTools": [
        "Read",
        "Grep",
        "Glob",
        "Bash(gh pr view {{number}}:*)",
        "Bash(gh pr diff {{number}}:*)",
        "Bash(git fetch origin {{base}})",
        "Bash(git merge-tree:*)",
        "Bash(jq:*)"
      ],
      "disallowedTools": [
        "Edit",
        "Write",
        "NotebookEdit",
        "WebFetch",
        "WebSearch"
      ]
    }
  }
}
