    "Bash(gh pr reopen:*)",
    "Bash(gh pr revert:*)",
    "Bash(gh pr review:*)",
    "Bash(gh pr unlock:*)",
    "Bash(gh pr update-branch:*)",
    "Bash(gh issue close:*)",
    "Bash(gh issue comment:*)",
    "Bash(gh issue create:*)",
    "Bash(gh issue delete:*)",
    "Bash(gh issue develop:*)",
    "Bash(gh issue edit:*)",
    "Bash(gh issue lock:*)",
    "Bash(gh issue pin:*)",
    "Bash(gh issue reopen:*)",
    "Bash(gh issue transfer:*)",
    "Bash(gh issue unlock:*)",
    "Bash(gh issue unpin:*)",
