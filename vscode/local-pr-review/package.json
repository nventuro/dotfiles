{
  "name": "local-pr-review",
  "displayName": "Local Review",
  "description": "Review your own code changes locally with inline comments — no GitHub or remote needed.",
  "version": "0.7.15",
  "publisher": "nventuro",
  "author": "Nicolás Venturo",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nventuro/dotfiles",
    "directory": "vscode/local-pr-review"
  },
  "homepage": "https://github.com/nventuro/dotfiles/tree/main/vscode/local-pr-review#readme",
  "bugs": {
    "url": "https://github.com/nventuro/dotfiles/issues"
  },
  "license": "MIT",
  "keywords": [
    "git",
    "pull request",
    "code review",
    "diff",
    "comments",
    "offline",
    "local"
  ],
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.git",
    "onView:localPrReview.changedFiles",
    "onView:localPrReview.localComments"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Local Review",
      "properties": {
        "localPrReview.defaultBase": {
          "type": "string",
          "default": "",
          "description": "Base ref to diff a review against when the review has no explicit base (Local Review: Set Review Base). Empty = the remote's default branch (origin/HEAD), then origin/main or origin/master. Set per workspace for repos with another base, e.g. \"origin/develop\"."
        }
      }
    },
    "colors": [
      {
        "id": "localPrReview.unresolvedCommentForeground",
        "description": "Color for files with review comments to do",
        "defaults": {
          "dark": "#e2c08d",
          "light": "#b58900",
          "highContrast": "#e2c08d",
          "highContrastLight": "#b58900"
        }
      }
    ],
    "languageModelTools": [
      {
        "name": "localPrReview_getComments",
        "displayName": "Get Local Review Comments",
        "toolReferenceName": "localReviewComments",
        "modelDescription": "Retrieves local code review comments stored by the 'Local Review' VS Code extension. This is NOT related to GitHub Pull Requests or any remote service. These are offline, local-only review comments that users create in diff views within VS Code. Call this tool when the user mentions: local comments, local review, review comments, self-review, check comments, local PR comments. The tool auto-detects the active review from the current git branch. If no review exists, tell the user to create one using the Local Review sidebar. Do NOT search the filesystem or run terminal commands to find comments — this tool is the ONLY way to access local review comments.",
        "icon": "$(comment-discussion)",
        "canBeReferencedInPrompt": true,
        "inputSchema": {
          "type": "object",
          "properties": {
            "filePath": {
              "type": "string",
              "description": "Optional workspace-relative file path to filter comments for a specific file. Example: 'src/main.py'"
            },
            "stage": {
              "type": "string",
              "enum": [
                "todo",
                "claude",
                "later",
                "closed"
              ],
              "description": "Optional filter by stage: 'todo' (the user's move), 'claude' (waiting for /address-review), 'later' (set aside), 'closed' (finished). Omit to get all comments."
            }
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localPrReview",
          "title": "Local Review",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "localPrReview": [
        {
          "id": "localPrReview.changedFiles",
          "name": "Changed Files"
        },
        {
          "id": "localPrReview.localComments",
          "name": "Comments"
        }
      ]
    },
    "commands": [
      {
        "command": "localPrReview.refresh",
        "title": "Refresh",
        "category": "Local Review",
        "icon": "$(refresh)"
      },
      {
        "command": "localPrReview.refreshPrs",
        "title": "Refresh PRs",
        "category": "Local Review",
        "icon": "$(refresh)"
      },
      {
        "command": "localPrReview.createReview",
        "title": "Create Review",
        "category": "Local Review",
        "icon": "$(add)"
      },
      {
        "command": "localPrReview.deleteReview",
        "title": "Delete Review",
        "category": "Local Review",
        "icon": "$(trash)"
      },
      {
        "command": "localPrReview.activateReview",
        "title": "Activate Review",
        "category": "Local Review"
      },
      {
        "command": "localPrReview.openDiff",
        "title": "Open Diff",
        "category": "Local Review"
      },
      {
        "command": "localPrReview.setReviewBase",
        "title": "Set Review Base…",
        "category": "Local Review",
        "icon": "$(git-branch)"
      },
      {
        "command": "localPrReview.applyAndClose",
        "title": "Apply & close: Claude makes the change on the next /address-review, then closes the thread",
        "category": "Local Review",
        "icon": "$(rocket)"
      },
      {
        "command": "localPrReview.apply",
        "title": "Apply: Claude makes the change on the next /address-review, then sends the thread back to you to check",
        "category": "Local Review",
        "icon": "$(tools)"
      },
      {
        "command": "localPrReview.later",
        "title": "Later: set aside until the next /address-review",
        "category": "Local Review",
        "icon": "$(watch)"
      },
      {
        "command": "localPrReview.discard",
        "title": "Discard: remove it from the review; nothing more happens with it",
        "category": "Local Review",
        "icon": "$(trash)"
      },
      {
        "command": "localPrReview.undo",
        "title": "Undo: take it back from Claude and return it to To do",
        "category": "Local Review",
        "icon": "$(discard)"
      },
      {
        "command": "localPrReview.reopen",
        "title": "Reopen: move it back to To do",
        "category": "Local Review",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "localPrReview.stepThrough",
        "title": "Step through To do",
        "category": "Local Review",
        "icon": "$(checklist)"
      },
      {
        "command": "localPrReview.editComment",
        "title": "Edit",
        "category": "Local Review",
        "icon": "$(edit)"
      },
      {
        "command": "localPrReview.saveEdit",
        "title": "Save",
        "category": "Local Review"
      },
      {
        "command": "localPrReview.cancelEdit",
        "title": "Cancel",
        "category": "Local Review"
      },
      {
        "command": "localPrReview.deleteComment",
        "title": "Delete",
        "category": "Local Review",
        "icon": "$(close)"
      },
      {
        "command": "localPrReview.addComment",
        "title": "Send to Claude",
        "category": "Local Review"
      },
      {
        "command": "localPrReview.saveComment",
        "title": "Send to Claude",
        "category": "Local Review"
      },
      {
        "command": "localPrReview.cancelComment",
        "title": "Cancel",
        "category": "Local Review"
      },
      {
        "command": "localPrReview.openFile",
        "title": "Open File",
        "category": "Local Review",
        "icon": "$(go-to-file)"
      },
      {
        "command": "localPrReview.expandAll",
        "title": "Expand All",
        "category": "Local Review",
        "icon": "$(expand-all)"
      },
      {
        "command": "localPrReview.openAllDiffs",
        "title": "Open All Diffs",
        "category": "Local Review",
        "icon": "$(diff-multiple)"
      },
      {
        "command": "localPrReview.suggestChange",
        "title": "Suggest a Change",
        "category": "Local Review",
        "icon": "$(lightbulb)"
      },
      {
        "command": "localPrReview.unreviewAll",
        "title": "Unmark all reviewed",
        "category": "Local Review",
        "icon": "$(clear-all)"
      },
      {
        "command": "localPrReview.reviewAll",
        "title": "Mark all reviewed",
        "category": "Local Review",
        "icon": "$(check-all)"
      },
      {
        "command": "localPrReview.markFileNotReviewed",
        "title": "Mark not reviewed",
        "category": "Local Review",
        "icon": "$(discard)"
      },
      {
        "command": "localPrReview.markChangeReviewed",
        "title": "Mark reviewed",
        "category": "Local Review",
        "icon": "$(check)"
      },
      {
        "command": "localPrReview.markReviewedAtCursor",
        "title": "Mark hunk reviewed",
        "category": "Local Review",
        "icon": "$(check)"
      },
      {
        "command": "localPrReview.markSelectedFileReviewed",
        "title": "Mark file reviewed",
        "category": "Local Review",
        "icon": "$(check)"
      },
      {
        "command": "localPrReview.replyComment",
        "title": "Reply: tell Claude what you want; it answers on the next /address-review",
        "category": "Local Review",
        "icon": "$(comment)"
      }
    ],
    "keybindings": [
      {
        "command": "localPrReview.markReviewedAtCursor",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "editorTextFocus && localPrReview.canMarkReviewed"
      },
      {
        "command": "localPrReview.markSelectedFileReviewed",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "focusedView == localPrReview.changedFiles"
      }
    ],
    "menus": {
      "scm/change/title": [
        {
          "command": "localPrReview.markChangeReviewed",
          "group": "inline",
          "when": "localPrReview.active"
        }
      ],
      "editor/title": [
        {
          "command": "localPrReview.markReviewedAtCursor",
          "group": "navigation@9",
          "when": "localPrReview.canMarkReviewed"
        }
      ],
      "editor/context": [
        {
          "command": "localPrReview.markReviewedAtCursor",
          "group": "1_modification@9",
          "when": "localPrReview.canMarkReviewed"
        }
      ],
      "view/title": [
        {
          "command": "localPrReview.setReviewBase",
          "when": "view == localPrReview.changedFiles",
          "group": "navigation@0"
        },
        {
          "command": "localPrReview.openAllDiffs",
          "when": "view == localPrReview.changedFiles",
          "group": "navigation@1"
        },
        {
          "command": "localPrReview.expandAll",
          "when": "view == localPrReview.changedFiles",
          "group": "navigation@2"
        },
        {
          "command": "localPrReview.refresh",
          "when": "view == localPrReview.changedFiles",
          "group": "navigation@3"
        },
        {
          "command": "localPrReview.stepThrough",
          "when": "view == localPrReview.localComments",
          "group": "navigation@1"
        },
        {
          "command": "localPrReview.refresh",
          "when": "view == localPrReview.localComments",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "localPrReview.reviewAll",
          "when": "view == localPrReview.changedFiles && viewItem == section.toReview",
          "group": "inline"
        },
        {
          "command": "localPrReview.unreviewAll",
          "when": "view == localPrReview.changedFiles && viewItem == section.reviewed",
          "group": "inline"
        },
        {
          "command": "localPrReview.markFileNotReviewed",
          "when": "view == localPrReview.changedFiles && viewItem =~ /^fileChange\\..*\\.reviewed$/",
          "group": "inline@1"
        },
        {
          "command": "localPrReview.openFile",
          "when": "view == localPrReview.changedFiles && viewItem =~ /^fileChange/",
          "group": "inline@2"
        },
        {
          "command": "localPrReview.applyAndClose",
          "when": "view == localPrReview.localComments && viewItem =~ /^commentNav\\.(todo|later|claude|claude\\.apply)$/",
          "group": "inline@0"
        },
        {
          "command": "localPrReview.apply",
          "when": "view == localPrReview.localComments && viewItem =~ /^commentNav\\.(todo|later|claude|claude\\.apply-close)$/",
          "group": "inline@1"
        },
        {
          "command": "localPrReview.later",
          "when": "view == localPrReview.localComments && viewItem =~ /^commentNav\\.todo$/",
          "group": "inline@2"
        },
        {
          "command": "localPrReview.discard",
          "when": "view == localPrReview.localComments && viewItem =~ /^commentNav\\.(todo|later|claude)/",
          "group": "inline@3"
        },
        {
          "command": "localPrReview.undo",
          "when": "view == localPrReview.localComments && viewItem =~ /^commentNav\\.claude/",
          "group": "inline@4"
        },
        {
          "command": "localPrReview.reopen",
          "when": "view == localPrReview.localComments && viewItem =~ /^commentNav\\.closed$/",
          "group": "inline@0"
        },
        {
          "command": "localPrReview.replyComment",
          "when": "view == localPrReview.localComments && viewItem =~ /^commentNav\\.(todo|later|claude)/",
          "group": "inline@5"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "localPrReview.addComment",
          "group": "inline@1",
          "when": "commentController == localPrReview && commentThreadIsEmpty"
        },
        {
          "command": "localPrReview.saveComment",
          "group": "inline@1",
          "when": "commentController == localPrReview && !commentThreadIsEmpty"
        },
        {
          "command": "localPrReview.suggestChange",
          "group": "inline@2",
          "when": "commentController == localPrReview && commentThread =~ /^(todo|later|claude)/"
        },
        {
          "command": "localPrReview.cancelComment",
          "group": "inline@3",
          "when": "commentController == localPrReview"
        }
      ],
      "comments/comment/title": [
        {
          "command": "localPrReview.editComment",
          "group": "inline@1",
          "when": "commentController == localPrReview && comment == canEdit"
        },
        {
          "command": "localPrReview.deleteComment",
          "group": "inline@2",
          "when": "commentController == localPrReview && comment == canEdit"
        }
      ],
      "comments/comment/context": [
        {
          "command": "localPrReview.saveEdit",
          "group": "inline@1",
          "when": "commentController == localPrReview"
        },
        {
          "command": "localPrReview.cancelEdit",
          "group": "inline@2",
          "when": "commentController == localPrReview"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "localPrReview.applyAndClose",
          "group": "inline@0",
          "when": "commentController == localPrReview && commentThread =~ /^(todo|later|claude|claude\\.apply)$/"
        },
        {
          "command": "localPrReview.apply",
          "group": "inline@1",
          "when": "commentController == localPrReview && commentThread =~ /^(todo|later|claude|claude\\.apply-close)$/"
        },
        {
          "command": "localPrReview.later",
          "group": "inline@2",
          "when": "commentController == localPrReview && commentThread =~ /^todo$/"
        },
        {
          "command": "localPrReview.discard",
          "group": "inline@3",
          "when": "commentController == localPrReview && commentThread =~ /^(todo|later|claude)/"
        },
        {
          "command": "localPrReview.undo",
          "group": "inline@4",
          "when": "commentController == localPrReview && commentThread =~ /^claude/"
        },
        {
          "command": "localPrReview.reopen",
          "group": "inline@0",
          "when": "commentController == localPrReview && commentThread =~ /^closed$/"
        }
      ],
      "commandPalette": [
        {
          "command": "localPrReview.applyAndClose",
          "when": "false"
        },
        {
          "command": "localPrReview.apply",
          "when": "false"
        },
        {
          "command": "localPrReview.later",
          "when": "false"
        },
        {
          "command": "localPrReview.discard",
          "when": "false"
        },
        {
          "command": "localPrReview.undo",
          "when": "false"
        },
        {
          "command": "localPrReview.reopen",
          "when": "false"
        },
        {
          "command": "localPrReview.replyComment",
          "when": "false"
        },
        {
          "command": "localPrReview.addComment",
          "when": "false"
        },
        {
          "command": "localPrReview.saveComment",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "package": "npm run compile && vsce package -o ../local-pr-review.vsix",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.97.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  }
}
